# Copy to .env and fill in. SUPABASE_URL should match VITE_SUPABASE_URL from root .env
# SUPABASE_SERVICE_ROLE_KEY: Supabase Dashboard > Settings > API > service_role key (not anon)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# QuickBooks Online (OAuth) — Phase 3B backend only; never commit real secrets
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=http://localhost:3001/api/quickbooks/oauth/callback
QB_ENV=sandbox
QB_MINOR_VERSION=75
QB_SUCCESS_REDIRECT_URL=http://localhost:5001
QB_FAILURE_REDIRECT_URL=http://localhost:5001

# AES-256 key for encrypting QuickBooks refresh tokens at rest (32 raw bytes, base64-encoded).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
QB_TOKEN_ENCRYPTION_KEY=

# AES-256 key for encrypting portal credential passwords at rest (32 raw bytes, base64).
# Same value must be available to Supabase Edge Functions that read credentials (e.g. permitwizard-execute).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PORTAL_CREDENTIALS_ENCRYPTION_KEY=

# Microsoft Graph delegated OAuth (Phase 3.5 — mailbox read for PEPCO email MFA automation)
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
MS_GRAPH_REDIRECT_URI=http://localhost:3002/api/microsoft/oauth/callback
# 32-byte key: openssl rand -hex 32  (preferred) OR base64 of random 32 raw bytes — never reuse QB keys
MS_GRAPH_TOKEN_ENCRYPTION_KEY=

# Invoice trigger fallback item when service_type does not match a QBO Item name
# QB_DEFAULT_ITEM_ID=
# QB_DEFAULT_ITEM_NAME=

# Arlington Plan Review max upload size (bytes). Default in code is 200 MiB; override to match Supabase bucket limit.
# Large Approved Plan Set PDFs (~120–125 MB) require at least 209715200 (200 * 1024 * 1024).
SUPABASE_STORAGE_OBJECT_MAX_BYTES=209715200
# One-shot: force re-download of rows saved as oversized_for_supabase (also: POST body forceRetryOversizedDownloads: true).
# ARLINGTON_FORCE_RETRY_OVERSIZED_PLAN_REVIEW_DOWNLOADS=true
# QB_DEV_PAYLOAD_PREVIEW=1 — enables POST /api/quickbooks/dev/payload-preview only (offline JSON; no Intuit).
# QB_DEV_API_TEST=1 — enables POST /api/quickbooks/dev/customer-test and GET /api/quickbooks/dev/items (live API).

# UCI D4 — PEPCO submission safety (default: dry-run only; never enable in dev without operator approval)
# UCI_PEPCO_LIVE_SUBMISSION_ENABLED=false
# UCI Stage 4 email live send (default OFF). Even when true, Prepare/Confirm never call Graph sendMail.
# UCI_EMAIL_LIVE_SUBMISSION_ENABLED=false
# Test-only allowlists required when live send is ON. Never list real utility inboxes.
# UCI_EMAIL_ALLOWED_SENDERS=dzahid@commun-et.com
# UCI_EMAIL_ALLOWED_RECIPIENTS=dzahid@commun-et.com
# Portal populate/submit stays OFF unless explicitly enabled.
# UCI_PEPCO_LIVE_SUBMISSION_ENABLED=false
# UCI_AUTO_STAGE_TRANSITIONS=false

# UCI D2.2 — Electric territory datasets (Supabase Storage in production)
# UCI_TERRITORY_STORAGE_ENABLED=false
# UCI_TERRITORY_STORAGE_BUCKET=
# UCI_TERRITORY_STORAGE_PREFIX=uci-territory
# UCI_TERRITORY_DATASET_VERSION=current
# UCI_TERRITORY_LOCAL_CACHE_DIR=/tmp/uci-territory-cache
# UCI_TERRITORY_DATA_DIR=scraper-service/data/territory/electric
# UCI_TERRITORY_ALLOW_LOCAL_FALLBACK=true
# UCI_TERRITORY_BOUNDARY_BUFFER_MILES=0.5
# UCI_GEOCODE_MIN_CONFIDENCE=medium

# UCI document processing — Vision/OCR fallback (disabled by default; explicit opt-in required)
# UCI_DOCUMENT_VISION_ENABLED=false
# UCI_DOCUMENT_OCR_ENABLED=false
# UCI_DOCUMENT_VISION_MAX_PAGES_PER_RUN=25
# UCI_DOCUMENT_OCR_MAX_PAGES_PER_RUN=25
# UCI_DOCUMENT_AI_TIMEOUT_MS=90000
# UCI_DOCUMENT_AI_MAX_RETRIES=1
# UCI_DOCUMENT_OCR_MIN_CONFIDENCE=0.6
# UCI_DOCUMENT_VISION_MODEL=gpt-4o
# UCI_DOCUMENT_OCR_MODEL=gpt-4o

# UCI Stage 5 LLM classifier (auto: Anthropic if configured, else OpenAI; keyword fallback always)
# OPENAI_API_KEY=  (reuses PermitPilot OpenAI key — primary when Anthropic absent)
# ANTHROPIC_API_KEY=
# UCI_LLM_CLASSIFIER_PROVIDER=auto
# UCI_LLM_CLASSIFIER_MODEL=gpt-4o
# UCI_LLM_CLASSIFIER_ENABLED=true
# UCI_CLAUDE_CLASSIFIER_ENABLED=true
# UCI_CLAUDE_CLASSIFIER_MODEL=claude-sonnet-4-20250514
# UCI_LLM_CLASSIFIER_TIMEOUT_MS=45000
# UCI_EMAIL_INBOUND_WEBHOOK_SECRET=

# UCI Graph inbound mailbox poller (application-owned; default ON with scraper process)
# Polls all microsoft_mailbox_connections with status=connected; idempotent ingest.
# UCI_GRAPH_INBOUND_POLLER_ENABLED=true
# UCI_GRAPH_INBOUND_POLL_MS=45000
# UCI_GRAPH_INBOUND_LOOKBACK_HOURS=48
# UCI_GRAPH_INBOUND_TOP=25
