# Copy to .env and fill in. SUPABASE_URL should match VITE_SUPABASE_URL from root .env
# SUPABASE_SERVICE_ROLE_KEY: Supabase Dashboard > Settings > API > service_role key (not anon)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# QuickBooks Online (OAuth) — Phase 3B backend only; never commit real secrets
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=http://localhost:3001/api/quickbooks/oauth/callback
QB_ENV=sandbox
QB_MINOR_VERSION=75
QB_SUCCESS_REDIRECT_URL=http://localhost:5001
QB_FAILURE_REDIRECT_URL=http://localhost:5001

# Invoice trigger fallback item when service_type does not match a QBO Item name
# QB_DEFAULT_ITEM_ID=
# QB_DEFAULT_ITEM_NAME=

# Optional production overrides (NODE_ENV=production):
# QB_DEV_PAYLOAD_PREVIEW=1 — enables POST /api/quickbooks/dev/payload-preview only (offline JSON; no Intuit).
# QB_DEV_API_TEST=1 — enables POST /api/quickbooks/dev/customer-test and GET /api/quickbooks/dev/items (live API).
