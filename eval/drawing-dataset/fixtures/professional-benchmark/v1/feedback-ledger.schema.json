{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "permitpilot.arc.feedback-ledger.v1",
  "title": "ARC feedback ledger entry",
  "description": "Append-only professional-review feedback. Never overwrites AI findings. independentlyVerified / contributesToMetrics default false.",
  "type": "object",
  "required": [
    "ledgerVersion",
    "recordId",
    "recordedAt",
    "source",
    "status",
    "pbItemId",
    "decision",
    "independentlyVerified",
    "contributesToMetrics"
  ],
  "additionalProperties": false,
  "properties": {
    "ledgerVersion": { "const": "arc.feedback-ledger.v1" },
    "recordId": { "type": "string", "minLength": 8 },
    "recordedAt": { "type": "string" },
    "source": {
      "type": "string",
      "enum": ["worksheet", "supabase_ui_export", "adjudication", "manual"]
    },
    "status": {
      "type": "string",
      "enum": ["preliminary", "finalized", "needs_second_review", "disputed"]
    },
    "pbItemId": { "type": ["string", "null"] },
    "findingOrCheckId": { "type": ["string", "null"] },
    "technicalCheckId": { "type": ["string", "null"] },
    "sourceRunId": { "type": ["string", "null"] },
    "findingId": { "type": ["string", "null"] },
    "sheetId": { "type": ["string", "null"] },
    "drawingNumber": { "type": ["string", "null"] },
    "drawingRevision": { "type": ["string", "null"] },
    "originalAi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": ["string", "null"] },
        "severity": { "type": ["string", "null"] },
        "rationale": { "type": ["string", "null"] },
        "evidenceQuote": { "type": ["string", "null"] }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "confirmed_issue",
        "false_positive",
        "partially_supported",
        "insufficient_evidence",
        "not_applicable",
        "accepted",
        "modified",
        "rejected"
      ]
    },
    "correctedInterpretation": { "type": ["string", "null"] },
    "modifiedSeverity": { "type": ["string", "null"] },
    "modifiedCodeReference": { "type": ["string", "null"] },
    "supportingEvidence": { "type": ["string", "null"] },
    "justification": { "type": ["string", "null"] },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "discipline": { "type": ["string", "null"] },
        "reviewedAt": { "type": ["string", "null"] }
      }
    },
    "analyzerVersion": { "type": ["string", "null"] },
    "evidenceExtractionVersion": { "type": ["string", "null"] },
    "independentlyVerified": { "type": "boolean" },
    "contributesToMetrics": { "type": "boolean" },
    "needsSecondReview": { "type": "boolean" },
    "disagreementWithRecordId": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] }
  }
}
