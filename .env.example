# Frontend (Vite) — required for local dev and Vercel deployments
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Legacy alias accepted by supabaseEnv.ts if VITE_SUPABASE_ANON_KEY is unset
# VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Scraper API base (local parallel stack uses http://localhost:5001)
# VITE_API_BASE_URL=http://localhost:5001
