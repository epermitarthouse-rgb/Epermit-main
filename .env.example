# Frontend (Vite) — copy to project root .env for local development.
# Production values are set in Vercel (All Environments). Never commit real keys.

# --- Local development: parallel stack (default `npm run dev`, Vite :5001 → scraper :3002) ---
# Leave unset to use Vite proxy, or:
# VITE_API_BASE_URL=http://localhost:5001

# --- Local development: classic stack (`npm run dev:classic`, Vite :5000 → scraper :3001) ---
# VITE_API_BASE_URL=http://localhost:5000

# --- Production (Vercel — examples only; set in dashboard, not in git) ---
# VITE_API_BASE_URL=https://epermit-main-production.up.railway.app
# VITE_SUPABASE_URL=https://eeqxyjrcldivtpikcpvk.supabase.co
# VITE_SUPABASE_ANON_KEY=<public anon key from Supabase Dashboard → Settings → API>

# Supabase Edge Function secret (set via `supabase secrets set`, not Vite):
# SCRAPER_SERVICE_URL=https://epermit-main-production.up.railway.app

# Parallel dev only (set by vite.config.parallel.ts — do not set manually for production)
# VITE_SCRAPER_USE_SAME_ORIGIN=true
